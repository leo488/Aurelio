# Copy to .env.local and fill in. Nothing here is secret except that the anon key should still
# only be used with Row Level Security switched on (see supabase/schema.sql).

# The two accounts. These are the only emails that can sign in.
VITE_LEO_EMAIL=leo@example.com
VITE_SONIA_EMAIL=sonia@example.com

# Leave both empty to keep all data on this device (local mode, seeded with demo data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional server-side endpoint for Ori (never put an LLM API key in the app).
VITE_ORI_ENDPOINT=
